# --- Aplicación ---------------------------------------------------------------
ENTORNO=desarrollo                 # desarrollo | produccion
SECRET_KEY=                        # obligatorio en producción: python -c "import secrets; print(secrets.token_urlsafe(48))"
# DATABASE_URL=postgresql://usuario:clave@host:5432/asesor   (sin definir: SQLite en backend/data/asesor.db)
MAX_UPLOAD_MB=25
REGISTRO_ABIERTO=true              # false: las cuentas de estudiante las crea el docente
SEED_DEMO=true                     # crea cuentas, laboratorios, entregas y evaluaciones de demostración

# --- Administrador inicial (solo se usa la primera vez) -------------------------
ADMIN_EMAIL=admin@asesor.edu.co
ADMIN_PASSWORD=                    # sin definir en desarrollo: Cambiar1234
ADMIN_NOMBRE=Administración

# --- Modelo de IA (también se configura en Administración → Modelo de IA) ------
IA_PROVEEDOR=simulado              # gemini | anthropic | openai | ollama | simulado
IA_MODELO=                         # vacío = modelo sugerido para el proveedor
IA_BASE_URL=                       # vacío = URL oficial del proveedor (Ollama: http://localhost:11434/v1)
IA_TEMPERATURA=                    # vacío = valor recomendado
IA_PASADAS_CONSISTENCIA=1          # 2 o 3: valora varias veces y marca discrepancias (multiplica el costo)
IA_MULTIMODAL=true                 # envía imágenes y el PDF al modelo si este lo admite
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Sandbox de verificación técnica -------------------------------------------
SANDBOX_HABILITADO=true            # false: solo análisis sin ejecutar pruebas
SANDBOX_TIMEOUT_S=60               # tiempo de reloj total
SANDBOX_CPU_S=30
SANDBOX_PRUEBA_S=10                # límite por cada prueba
SANDBOX_MEMORIA_MB=1024
SANDBOX_PERMITIR_RED=false
